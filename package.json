{
  "name": "podman-login",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "GitHub Action to log in against a container image registry",
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-actions/podman-login"
  },
  "main": "dist/index.js",
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "ncc build src/index.ts --source-map --minify",
    "clean": "rm -rf out/ dist/",
    "lint": "eslint . --max-warnings=0",
    "generate-ios": "npx action-io-generator -w -o ./src/generated/inputs-outputs.ts"
  },
  "keywords": [],
  "author": "Red Hat",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@aws-sdk/client-ecr": "^3.1111.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redhat-actions/action-io-generator": "^1.5.0",
    "@types/node": "^26.2.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
